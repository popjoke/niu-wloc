name: Niu WLOC 定位修改
desc: "Niu WLOC · Apple 网络定位修改 | 使用说明: https://github.com/popjoke/niu-wloc#使用方法"
author: Yu9191 Rewrite
homepage: https://github.com/popjoke/niu-wloc
icon: https://raw.githubusercontent.com/popjoke/niu-wloc/refs/heads/main/wloc.jpg
category: Tools

http:
  mitm:
    - "gs-loc.apple.com"
    - "gs-loc-cn.apple.com"
    - "gsp-ssl.ls.apple.com"
    - "bluedot.is.autonavi.com"
    - "bluedot.is.autonavi.com.gds.alibabadns.com"
  script:
    - match: ^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc
      name: WLOC.Location
      type: response
      require-body: true
      binary-mode: true
      max-size: 0
      timeout: 30
      argument: longitude=113.94114&latitude=22.544577&accuracy=25&randomRadius=0&logLevel=info
    - match: ^https?:\/\/gs-loc(-cn)?\.apple\.com\/wloc-settings\/save
      name: WLOC.Settings
      type: request
      require-body: false
      timeout: 10

script-providers:
  WLOC.Location:
    url: https://raw.githubusercontent.com/popjoke/niu-wloc/refs/heads/main/dist/wloc.js
    interval: 86400
  WLOC.Settings:
    url: https://raw.githubusercontent.com/popjoke/niu-wloc/refs/heads/main/dist/wloc-settings.js
    interval: 86400
